# Dockerfile para el backend en Railway.
# Root Directory de Railway limita el build a lo copiado aqui; por eso
# este Dockerfile vive en la raiz del repo y copia backend/ + database/
# juntos, replicando el mismo layout que usa Render (backend/scripts/
# runMigrations.js resuelve las migraciones como ../../database/migrations
# relativo a si mismo).
FROM node:22-slim

WORKDIR /app

COPY backend/package.json backend/package-lock.json ./backend/
RUN npm install --prefix backend --omit=dev

COPY backend ./backend
COPY database ./database

WORKDIR /app/backend

ENV NODE_ENV=production
EXPOSE 5000

CMD ["npm", "start"]
